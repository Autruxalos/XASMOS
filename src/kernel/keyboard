[BITS 64]

global keyboard_read_scancode
global keyboard_read_char

section .text

keyboard_read_scancode:
.wait:
    in al, 0x64
    test al, 0x01
    jz .wait
    in al, 0x60
    ret

keyboard_read_char:
    call keyboard_read_scancode
    test al, 0x80
    jnz keyboard_read_char

    movzx rbx, al
    lea rsi, [rel scancode_ascii_table]
    mov al, [rsi + rbx]

    test al, al
    jz keyboard_read_char
    ret

section .rodata

scancode_ascii_table:
    db 0,  27, '1', '2', '3', '4', '5', '6', '7', '8', '9', '0', '-', '=', 8, 9
    db 'q', 'w', 'e', 'r', 't', 'y', 'u', 'i', 'o', 'p', '[', ']', 13, 0
    db 'a', 's', 'd', 'f', 'g', 'h', 'j', 'k', 'l', ';', '\'', '`', 0, '\'
    db 'z', 'x', 'c', 'v', 'b', 'n', 'm', ',', '.', '/', 0, '*', 0, ' '
    times 256 - ($ - scancode_ascii_table) db 0
